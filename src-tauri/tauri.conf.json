{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Toolkit",
  "version": "0.1.0",
  "identifier": "ir.virapeak.imagetoolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Image Toolkit",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "resources": {
      "vendor/linux-x64/": "vendor/linux-x64",
      "vendor/windows-x64/": "vendor/windows-x64",
      "vendor/THIRD_PARTY_NOTICES/": "vendor/THIRD_PARTY_NOTICES"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "ViraPeak",
    "copyright": "Copyright © 2026 ViraPeak",
    "shortDescription": "Transparent batch image processing GUI",
    "longDescription": "Image Toolkit is a transparent desktop GUI for ImageMagick, cwebp and avifenc.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
