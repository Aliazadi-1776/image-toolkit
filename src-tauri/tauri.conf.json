{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Toolkit",
  "version": "0.1.0",
  "identifier": "ir.virapeak.imagetoolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Image Toolkit",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "publisher": "ViraPeak",
    "copyright": "Copyright © 2026 ViraPeak",
    "shortDescription": "Transparent batch image processing GUI",
    "longDescription": "Image Toolkit is a transparent desktop GUI for ImageMagick, cwebp, avifenc and ExifTool.",
    "resources": {
      "vendor/windows-x64/": "vendor/windows-x64"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
